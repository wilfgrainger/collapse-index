// Public Worker: static assets and the read-only JSON API.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collapse-index-web",
  "main": "src/web/index.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "GIT_SHA": "unknown",
    "BOOTSTRAP_MODE": "disabled"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collapse-index",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],

  "observability": {
    "enabled": true
  }
}
